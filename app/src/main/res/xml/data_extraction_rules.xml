<?xml version="1.0" encoding="utf-8"?>
<!--
    The Home Assistant token is encrypted with a non-exportable Android Keystore key: a restored
    copy could never be decrypted, and the server address describes the user's home network.
    Both are excluded from cloud backup and device transfer.

    The database holds the lists, the items and the purchase history (product_usage): it never
    leaves the phone for a backup service, but it follows the user to a new phone in a direct
    device transfer. Its journal files go with it.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/home_assistant.preferences_pb" />
        <exclude domain="file" path="datastore/secrets.preferences_pb" />
        <exclude domain="database" path="courses.db" />
        <exclude domain="database" path="courses.db-journal" />
        <exclude domain="database" path="courses.db-wal" />
        <exclude domain="database" path="courses.db-shm" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/home_assistant.preferences_pb" />
        <exclude domain="file" path="datastore/secrets.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
